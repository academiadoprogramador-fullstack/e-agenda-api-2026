{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "e-agenda-api",
    "Audience": "e-agenda-client",
    "AccessTokenMinutes": 60
  },
  "Infra": {
    "NewRelic": {
      "Enabled": true,
      "ApplicationName": "e-agenda-api-prod"
    }
  },
  "AllowedHosts": "*"
}
